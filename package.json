{
  "name": "dsh-kv-computer-use",
  "version": "1.2.2",
  "description": "Transactional computer use for DeepSeek Harness on Windows: five-state outcomes, freshness boundary with pid+exe identity, guards, element search, background write (ValuePattern/WM_SETTEXT), UIA text reading, OCR fallback, resident input daemon, and a Web UI dock with Esc stop.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/Kvxw1105/dsh-kv-computer-use.git"
  },
  "homepage": "https://github.com/Kvxw1105/dsh-kv-computer-use#readme",
  "bugs": {
    "url": "https://github.com/Kvxw1105/dsh-kv-computer-use/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "windows",
    "uia",
    "automation"
  ]
}
